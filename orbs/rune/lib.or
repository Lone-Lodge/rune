# rune - innehallsadresserad lagring med content-defined chunking.
#
# En fil lagras inte som en fil utan som ett RECEPT: listan av chunkar den
# bestar av. Chunkgransen valjs av innehallet via en rullande hash, inte av
# en fast storlek. Det ar hela poangen: andras en byte mitt i en 200 MB
# .uasset flyttas inte alla efterfoljande granser, sa bara den chunken ar ny.
# Helfilshashning (git-LFS) skulle lagra 200 MB igen.
#
#   chunk      innehall -> sha256. Variabel storlek.
#   blob       en fils recept: chunk-id, ett per rad.
#   manifest   en ogonblicksbild: "sokvag<TAB>blob-id", en per rad.
#   commit     foralder, manifest-id, forfattare, tid, meddelande.
#
# Chunk-id ar hashen av det OKOMPRIMERADE innehallet. Darfor kan komprimering
# laggas till senare som en ren lagringstransform utan att ett enda id andras.

use compress
use encoding
use file
use os
use arena
use text

# --- chunkparametrar ----------------------------------------------------
# FRUSNA. Andras nagot av detta flyttas varje grans och all dedup mot
# befintliga repon forsvinner. De ar en del av formatet, inte en installning.
define chunk_min() -> number = 16384
define chunk_norm() -> number = 65536
define chunk_max() -> number = 262144
# Grans nar (fp & mask) is 0. Strangare mask (16 bitar, 1/65536) fore
# normalstorleken, losare (14 bitar, 1/16384) efter: det drar storlekarna
# mot 64 KB istallet for en lang svans.
#
# Bitarna ar SPRIDDA over hela ordet, inte de lagsta. I en gear-hash beror
# bit k bara pa de k+1 senaste bytesen, sa en lagbitsmask (0xFFFF) skulle ge
# ett 16-bytes fonster. Spridda bitar upp till bit 31 ger hela 32.
define mask_strict() -> number = 3743924328
define mask_loose() -> number = 2329563190

# 256 tal ur en MINSTD-generator med fast fro. Tabellen ar en del av
# formatet: samma bytes maste ge samma granser for alltid.
define gear_table() -> [number]:
    edit t = []
    edit x = 1
    loop i in 0 until 256:
        x = (x * 48271) % 2147483647
        t = append(t, x)
    t

# Nasta grans efter `from`. Fingeravtrycket NOLLSTALLS vid varje chunkstart
# och granssokningen slutar senast chunk_max fram, sa en grans beror bara pa
# bytesen fran `from` och som mest chunk_max framat. Det ar den egenskapen
# som gor att en fil kan chunkas genom ett fonster i stallet for hel.
#
# -1 nar fonstret tog slut innan en grans hittades och mer finns att lasa.
# `at_eof` sager att det som ligger har ar allt som finns, och da ar filslutet
# sjalvt en grans.
define cut_after(b: [number], from: number, gear: [number], at_eof: truth) -> number:
    n = bytes_count(b)
    edit fp = 0
    edit i = from + chunk_min()
    edit cut = 0 - 1
    loop:
        if i >= n:
            cut = if at_eof then n else 0 - 1
            break
        if i - from >= chunk_max():
            cut = i
            break
        fp = ((fp * 2) + gear[byte_at(b, i)]) % 4294967296
        mask = if i - from < chunk_norm() then mask_strict() else mask_loose()
        if (fp & mask) is 0:
            cut = i + 1
            break
        i = i + 1
    cut

# Slutoffsets for varje chunk i `b`. Sista elementet ar alltid langden.
# Hela filen i minnet: bara `rune stat`, som visar chunkningen av EN fil.
public define chunk_offsets(b: [number]) -> [number]:
    gear = gear_table()
    n = bytes_count(b)
    edit cuts = []
    edit start = 0
    loop:
        if start >= n:
            break
        cut = cut_after(b, start, gear, true)
        cuts = append(cuts, cut)
        start = cut
    cuts

# --- objektlagring ------------------------------------------------------
# Ett objekt bor pa <rune>/<sort>/ab/cdef..., tva hex som mapp sa en katalog
# aldrig far hundratusen poster.
define object_path(rune_dir: text, sort: text, id: text) -> text:
    head = text_of(bytes_part(bytes_of(id), 0, 2))
    rest = text_of(bytes_part(bytes_of(id), 2, byte_count(id)))
    rune_dir + "/" + sort + "/" + head + "/" + rest

# --- att skriva RAKT in i en pack -----------------------------------------
# `add` av 3200 filer tog 47 sekunder mot gits 10, och nastan allt var att
# SKAPA filer: tva objekt per fil, och en ny fil pa Windows kostar
# millisekunder. En SKRIVARE haller en pack oppen och lagger objekten i den.
#
# Den komprimerar INTE. Var kompressor gor 7 MB/s, sa att komprimera medan
# man koar hade gjort `add` langsammare an den var. Packen komprimeras av
# `rune pack`, som ar underhallssteget - samma delning som git har mellan
# att skriva ett objekt och att packa om.
#
# Slotarna ar PROCESSENS: en skrivare lever fran att `add` oppnar den till
# att den stangs, och det ar hela dess livstid.
define writer_pa() -> truth = slot_has("rune:w") and slot_get_number("rune:w:oppen") is 1

public define writer_open(root: text) uses files:
    rd = rune_dir(root)
    mkdir_all(pack_dir(rd))
    n = length(list_dir(pack_dir(rd)))
    bas = pack_dir(rd) + "/" + ((n + 1) as text)
    h = open_write(bas + ".pack")
    if not ok(h):
        return
    i = open_write(bas + ".idx")
    if not ok(i):
        stangd = close(h)
        return
    slot_set("rune:w", h)
    slot_set("rune:w:i", i)
    slot_set("rune:w:at", 0)
    slot_set("rune:w:namn", bas)
    slot_set("rune:w:oppen", 1)
    edit sedda: table of text = {}
    slot_set("rune:w:sedda", sedda)

public define writer_close() uses files:
    if not writer_pa():
        return
    a = close(slot_get_number("rune:w"))
    b = close(slot_get_number("rune:w:i"))
    slot_set("rune:w:oppen", 0)
    # En vanda som inte lagrade nagot nytt ska inte lamna tva tomma filer.
    if slot_get_number("rune:w:at") is 0:
        bas = slot_get("rune:w:namn")
        p1 = remove_file(bas + ".pack")
        p2 = remove_file(bas + ".idx")

# Registret skrivs rad for rad medan vi gar, sa en avbruten `add` lamnar en
# pack och ett register som stammer med varandra.
define writer_put(sort: text, id: text, body: text) -> truth uses files:
    edit sedda: table of text = slot_get("rune:w:sedda")
    if has(sedda, id):
        return true
    langd = bytes_count(body)
    at = slot_get_number("rune:w:at")
    if write_chunk(slot_get_number("rune:w"), body) < 0:
        return false
    rad = id + tab() + sort + tab() + (at as text) + tab() + (langd as text) + tab() + (langd as text) + text_of([10])
    skrev = write_chunk(slot_get_number("rune:w:i"), rad)
    slot_set("rune:w:at", at + langd)
    # Tabellen lever langre an varvet, sa BADE nyckeln och tabellens egen
    # tillvaxt maste till malloc. En insattning medan arenan ar pa lagger
    # de nya hinkarna DAR, och nasta svep river dem under tabellen - det
    # blir en lasning av frigjort minne nasta gang nagon fragar den.
    was = persist_on()
    sedda[persisted(id)] = ""
    persist_off(was)
    true

# Skriv ett objekt om det inte redan finns. Returnerar id:t, eller "" om
# skrivningen inte gick igenom.
#
# Den halvskrivna filen TAS BORT. En full disk eller en krasch mitt i
# skrivningen lamnar annars en stympad fil under ett giltigt id, och da
# sager `has_object` for alltid att vi har objektet. Det ar varre an att
# sakna det: ett saknat objekt syns, ett fel objekt gor det inte.
public define put_object(rune_dir: text, sort: text, body: text) -> text uses files:
    id = sha256(body)
    if has_object(rune_dir, sort, id):
        return id
    if writer_pa():
        return if writer_put(sort, id, body) then id else ""
    path = object_path(rune_dir, sort, id)
    mkdir_all(path_parent(path))
    if write_file(path, body) is 0:
        skrap = remove_file(path)
        return ""
    id

# --- packar --------------------------------------------------------------
# Ett objekt per fil kostar bade plats och tid. En 2 KB-chunk tar 4 KB pa
# ett filsystem med 4 KB-kluster, och att SKAPA en fil ar det dyra pa
# Windows. Matt: 2000 filer blev 4005 objekt, 4281 KB innehall och 12399 KB
# pa disk - alltsa nastan tre ganger - och `add` av 3200 filer tog 47
# sekunder mot gits 10.
#
# En PACK ar manga kroppar efter varandra i en fil, med ett register
# bredvid som sager var var och en borjar:
#
#   .rune/pack/<n>.pack    kropparna, en efter en
#   .rune/pack/<n>.idx     "id<TAB>sort<TAB>start<TAB>lagrad<TAB>ra", en per rad
#
# TVA langder: hur manga bytes kroppen tar i packen, och hur stor den ar i
# sanning. Ar de lika ligger den okomprimerad. Varje objekt provas for sig
# och lagras rakt av nar komprimeringen inte vann - en .uasset-chunk VAXER
# av att komprimeras, och den ska inte betala for det.
#
# Id:t ar fortfarande hashen av kroppen, sa en pack ar en LAGRINGSFORM och
# inte ett nytt format. Samma repo kan ha bade losa objekt och packar, och
# den som laser behover inte veta vilket det ar.
public define pack_dir(rune_dir: text) -> text = rune_dir + "/pack"

# Registret over ALLA packar. Byggt en gang per process och sparat i en
# slot: att lasa registerfilerna en gang per objekt hade gjort varje
# uppslagning till en genomlasning.
define pack_index(rune_dir: text) -> table of text uses files:
    if slot_has("rune:pack"):
        return slot_get("rune:pack")
    # Registret lever hela processen, sa det byggs i malloc och inte i
    # arenan. Bygger man det medan en arena ar pa hamnar bade nycklar och
    # varden dar, och runtimen sager ifran nar en sadan tabell laggs i en
    # slot - den kan inte veta hur den ska kopiera ut den at oss.
    was = persist_on()
    edit m: table of text = {}
    pd = pack_dir(rune_dir)
    if is_dir(pd) is not 0:
        loop f in list_dir(pd):
            if ends_with(f, ".idx"):
                bas = text_of(bytes_part(bytes_of(f), 0, byte_count(f) - 4))
                loop rad in read_lines(pd + "/" + f):
                    d = split(rad, tab())
                    if length(d) >= 5:
                        m[persisted(d[1] + "/" + d[0])] = persisted(bas + tab() + d[2] + tab() + d[3] + tab() + d[4])
    slot_set("rune:pack", m)
    persist_off(was)
    m

# Kroppen ur en pack, "" om objektet inte ligger i nagon.
define from_pack(rune_dir: text, sort: text, id: text) -> text uses files:
    m = pack_index(rune_dir)
    k = sort + "/" + id
    if not has(m, k):
        return ""
    d = split(m[k], tab())
    h = open_read(pack_dir(rune_dir) + "/" + d[0] + ".pack")
    if not ok(h):
        return ""
    defer close(h)
    if seek(h, int_from_text(d[1])) is not 0:
        return ""
    want = int_from_text(d[2])
    ra = int_from_text(d[3])
    # read_chunk far ge farre bytes an man bad om, sa las tills det racker.
    edit bitar = []
    edit har = 0
    loop:
        if har >= want:
            break
        bit = read_chunk(h, want - har)
        if is_end(bit):
            break
        bitar = append(bitar, bit)
        har = har + bytes_count(bit)
    hel = join(bitar, "")
    if want is ra then hel else unsqueeze(hel)

public define get_object(rune_dir: text, sort: text, id: text) -> text uses files:
    p = object_path(rune_dir, sort, id)
    if file_exists(p) is not 0 then read_file(p) else from_pack(rune_dir, sort, id)

public define has_object(rune_dir: text, sort: text, id: text) -> truth uses files:
    if file_exists(object_path(rune_dir, sort, id)) is not 0:
        return true
    if writer_pa():
        edit sedda: table of text = slot_get("rune:w:sedda")
        if has(sedda, id):
            return true
    has(pack_index(rune_dir), sort + "/" + id)

# Ett objekts storlek utan att lasa det. Objekten ar OKOMPRIMERADE, sa en
# chunkfils storlek ar chunkens langd. Det ar den egenskapen som gor bade
# storleksfragan och slumpvis lasning gratis.
public define object_size(rune_dir: text, sort: text, id: text) -> number uses files:
    p = object_path(rune_dir, sort, id)
    if file_exists(p) is not 0:
        return size_of(p)
    m = pack_index(rune_dir)
    k = sort + "/" + id
    if not has(m, k):
        return 0 - 1
    # Den SANNA storleken, inte den lagrade. Allt utanfor packen raknar i
    # riktiga bytes - offsets i en fil, langder i ett svar.
    int_from_text(split(m[k], tab())[3])

# --- filer in och ut ----------------------------------------------------
# Gar en enda chunk inte att lagra ar hela receptet vardelost, sa "" ut
# och ingen halvfardig blob in i lagret.
define chunk_ids_ok(ids: [text]) -> truth:
    edit ok = true
    loop id in ids:
        if is_empty(id):
            ok = false
    ok

# En fils chunkar, i ordning, genom ett FONSTER over filen och inte hela
# filen i minnet. `bytes_of` gor en lista med ett tal per byte, sa en
# 256 MB-fil kostade 4,6 GB att lagra - atton ganger sin egen storlek.
#
# En vandring, tva arenden: `spara` skiljer den som LAGRAR chunkarna fran
# den som bara vill veta id:t. De sex raderna stod med flit tva ganger
# forut, men med fonstret att halla reda pa ar duplikatet inte langre
# billigare att lasa an det ena ordet ar.
define read_block() -> number = 1048576

define chunk_ids(rune_dir: text, path: text, spara: truth) -> [text] uses files:
    gear = gear_table()
    h = open_read(path)
    if not ok(h):
        return []
    defer close(h)
    # Fott FORE arenan slas pa, alltsa i malloc. Allt som laggs till i `ids`
    # laggs till under persist, sa listan bor kvar dar hela vagen.
    edit ids = []
    edit rest = ""
    edit slut = false
    edit arenan = false
    loop:
        if not slut:
            bit = read_chunk(h, read_block())
            if is_end(bit):
                slut = true
            else:
                rest = rest + bit
        win = bytes_of(rest)
        n = bytes_count(win)
        edit at = 0
        loop:
            if at >= n:
                break
            cut = cut_after(win, at, gear, slut)
            if cut < 0:
                break
            del = text_of(bytes_part(win, at, cut))
            id = if spara then put_object(rune_dir, "chunks", del) else sha256(del)
            # TVA saker maste over gransen: id:t sjalvt, som foddes i
            # arenan, och listan det laggs i - en append allokerar en ny
            # lista och den hade annars ocksa hamnat dar. Utan detta pekar
            # raderna i receptet in i minne nasta varv skriver over.
            kvar = persisted(id)
            was = persist_on()
            ids = append(ids, kvar)
            persist_off(was)
            at = cut
        # Det som blev over ar borjan pa nasta chunk och aldrig mer an
        # chunk_max, sa fonstret vaxer inte med filen. Det ska ocksa over.
        rest = persisted(text_of(bytes_part(win, at, n)))
        # Varvet ar slut: fonstret, chunkarna och hashningen var allt som
        # allokerades och inget av det behovs mer. Utan svepet vaxer minnet
        # med filens storlek - 256 MB kostade 4,6 GB, nu 54 MB.
        if arenan:
            svept = arena_reset()
        else if not slut:
            # Filen rymdes inte i ETT fonster. Fran och med nasta varv ar
            # allt varvet allokerar skrap efterat, och da lonar sig arenan.
            # En liten fil kommer aldrig hit och betalar alltsa ingenting.
            arenan = true
            pa = arena_on()
        if slut and is_empty(rest):
            break
    if arenan:
        av = arena_off()
    ids

# Blob-kroppen ar chunk-id, ett per rad. EN regel, delad av den som lagrar
# och den som bara vill veta id:t - annars kan status och add glida isar.
define blob_body(ids: [text]) -> text = join(ids, "\n")

# Lagra en fil: chunka, skriv de chunkar som saknas, skriv receptet.
# Returnerar blob-id.
define put_file(rune_dir: text, path: text) -> text uses files:
    ids = chunk_ids(rune_dir, path, true)
    if not chunk_ids_ok(ids):
        return ""
    put_object(rune_dir, "blobs", blob_body(ids))

# Blob-id for en fil UTAN att lagra nagot. Status ska inte skriva objekt.
define file_blob_id(path: text) -> text uses files:
    sha256(blob_body(chunk_ids("", path, false)))

# Hur manga chunkar en fil blir, utan att lagra nagot och utan att lasa
# den hel. `rune stat` ar det enda som fragar.
public define chunk_count(path: text) -> number uses files:
    length(chunk_ids("", path, false))

# Chunk-id:n ur ett recept, i ordning.
define blob_chunks(rune_dir: text, blob_id: text) -> [text] uses files:
    edit ids = []
    loop id in split(get_object(rune_dir, "blobs", blob_id), "\n"):
        if not is_empty(id):
            ids = append(ids, id)
    ids

# Innehallet bakom ett blob-id: chunkarna, i receptets ordning.
#
# `join` och inte `body = body + chunk`: det senare kopierar allt som redan
# byggts en gang per chunk, alltsa kvadratiskt i filstorlek. Matt pa en
# 32 MB-fil: 2,5 sekunder, och en 200 MB .uasset hade tagit minuter.
define blob_bytes(rune_dir: text, blob_id: text) -> text uses files:
    edit parts = []
    loop id in blob_chunks(rune_dir, blob_id):
        parts = append(parts, get_object(rune_dir, "chunks", id))
    join(parts, "")

# Har vi varje chunk receptet behover? En chunk ar aldrig tom, sa ett
# saknat objekt gar att skilja fran ett tomt. Utan den har fragan skriver
# aterskapningen en TYST trasig fil nar en chunk fattas.
define blob_complete(rune_dir: text, blob_id: text) -> truth uses files:
    if not has_object(rune_dir, "blobs", blob_id):
        return false
    edit hel = true
    loop id in split(get_object(rune_dir, "blobs", blob_id), "\n"):
        if not is_empty(id) and not has_object(rune_dir, "chunks", id):
            hel = false
    hel

# Aterskapa en fil ur sitt recept. false om nagon chunk saknas - da rors
# filen inte alls.
define get_file(rune_dir: text, blob_id: text, out_path: text) -> truth uses files:
    if not blob_complete(rune_dir, blob_id):
        return false
    mkdir_all(path_parent(out_path))
    # Skyddet av innan skrivningen: en fil nagon annan haller ar
    # skrivskyddad pa disk, och da hade open_write nekats. Den som satter
    # skyddet satter tillbaka det efterat.
    skydd = set_readonly(out_path, false)
    h = open_write(out_path)
    if not ok(h):
        return false
    defer close(h)
    # Chunk for chunk ut. Byggs hela filen i minnet forst ar det storsta
    # FILEN som satter taket i stallet for storsta chunken.
    loop id in blob_chunks(rune_dir, blob_id):
        wrote = write_chunk(h, get_object(rune_dir, "chunks", id))
    true

# --- repo ---------------------------------------------------------------
# Arbetstradet ar sanningen om NUET; .rune ar sanningen om historien.
#
#   index      koade filer: "sokvag<TAB>blob-id", en per rad
#   manifest   samma format, men en hel ogonblicksbild, sorterad pa sokvag
#   commit     fyra faltrader, tom rad, sedan meddelandet (som far radbrytas)
#
# Manifestet SORTERAS. Samma trad maste ge samma manifest-id, annars delar
# tva identiska ogonblicksbilder inte objekt.

use iter
use time

define tab() -> text = text_of([9])

public define rune_dir(root: text) -> text = root + "/.rune"

public define is_repo(root: text) -> truth uses files:
    is_dir(rune_dir(root)) is not 0

public define init(root: text) uses files:
    rd = rune_dir(root)
    mkdir_all(rd + "/refs/heads")
    write_file(rd + "/HEAD", "refs/heads/main")
    write_file(rd + "/index", "")
    gitignorera(root)

# Finns redan en git i mappen ska den inte borja spara VART lager. Raden
# laggs bara om .gitignore saknar den; vi skriver aldrig om nagons fil mer
# an sa. Utan det dyker .rune/ upp som ospardad i git-panelen bredvid.
define gitignorera(root: text) uses files:
    if is_dir(root + "/.git") is 0:
        return
    p = root + "/.gitignore"
    edit fanns = ""
    if file_exists(p) is not 0:
        fanns = read_file(p)
        loop l in split(fanns, "''' + BS + '''n"):
            if trim(l) is ".rune/" or trim(l) is ".rune":
                return
    nl = text_of([10])
    svans = if is_empty(fanns) or ends_with(fanns, nl) then "" else nl
    write_file(p, fanns + svans + ".rune/" + nl)

# --- ignorering ---------------------------------------------------------
# En rad per monster i .runeignore. Matchningen ar prefix pa den relativa
# sokvagen - `Saved/` tar allt darunder. Inga globbar i v1; det racker for
# de mappar man faktiskt vill halla utanfor.
define ignore_list(root: text) -> [text] uses files:
    edit pats = [".rune/"]
    f = root + "/.runeignore"
    if file_exists(f) is not 0:
        loop line in split(read_file(f), "\n"):
            p = trim(line)
            if not is_empty(p) and not starts_with(p, "#"):
                pats = append(pats, p)
    pats

# `*` star for vilken foljd som helst, aven tom och aven over `/`. Inget
# annat monster: `?` och `[a-z]` har ingen bett om, och varje tecken till
# ar ett tecken den som laser .runeignore maste minnas.
#
#   *.log        varje .log var den an ligger
#   Saved/*      allt under Saved
#
# Klassisk tvapekarmatchning: vid en stjarna kommer man ihag var den stod
# och hur langt in i strangen man var, och vid en krock backar man dit och
# later stjarnan svalja ett tecken till.
define glob_match(pat: text, s: text) -> truth:
    p = bytes_of(pat)
    t = bytes_of(s)
    np = bytes_count(p)
    nt = bytes_count(t)
    edit i = 0
    edit j = 0
    edit star = 0 - 1
    edit mark = 0
    loop:
        if i >= nt:
            break
        if j < np and byte_at(p, j) is 42:
            star = j
            mark = i
            j = j + 1
        else if j < np and byte_at(p, j) is byte_at(t, i):
            i = i + 1
            j = j + 1
        else if star >= 0:
            j = star + 1
            mark = mark + 1
            i = mark
        else:
            return false
    loop:
        if j < np and byte_at(p, j) is 42:
            j = j + 1
        else:
            break
    j >= np

# Ett monster UTAN stjarna ar ett prefix, precis som forut: `Saved/` tar
# allt darunder. Med stjarna matchas hela den relativa sokvagen.
define ignored(rel: text, pats: [text]) -> truth:
    edit hit = false
    loop p in pats:
        if index_of(p, "*") >= 0:
            if glob_match(p, rel):
                hit = true
        else if starts_with(rel, p) or rel is trim_end_slash(p):
            hit = true
    hit

define trim_end_slash(p: text) -> text:
    if ends_with(p, "/") then text_of(bytes_part(bytes_of(p), 0, byte_count(p) - 1)) else p

# Alla filer under `root`, som relativa sokvagar, ignorerade bortsorterade.
public define walk(root: text) -> [text] uses files:
    walk_at(root, "", ignore_list(root))

define walk_at(root: text, rel: text, pats: [text]) -> [text] uses files:
    here = if is_empty(rel) then root else root + "/" + rel
    edit out = []
    loop name in list_dir(here):
        if not is_empty(name):
            r = if is_empty(rel) then name else rel + "/" + name
            if not ignored(r, pats):
                out = append(out, r)
    loop d in list_dirs(here):
        if not is_empty(d):
            r = if is_empty(rel) then d else rel + "/" + d
            if not ignored(r + "/", pats):
                loop deeper in walk_at(root, r, pats):
                    out = append(out, deeper)
    out

# --- index --------------------------------------------------------------
# Raderna ar "sokvag<TAB>blob-id". Sma hjalpare istallet for en map-typ:
# formatet ar redan textrader pa disk, sa text in och text ut halls ihop.
define read_lines(path: text) -> [text] uses files:
    if file_exists(path) is 0:
        return []
    edit out = []
    loop line in split(read_file(path), "\n"):
        if not is_empty(line):
            out = append(out, line)
    out

# Index och las ar FORANDERLIGA radfiler som vanliga verktyg ska kunna
# lasa och lagga till i, sa de slutar med radbrytning. Blob- och
# manifestkroppar gor det INTE: de ligger under en hash, och en byte
# till dar hade andrat varje id utan att ge nagot.
define write_lines(path: text, lines: [text]) uses files:
    write_file(path, if length(lines) is 0 then "" else join(lines, "\n") + text_of([10]))

public define entry_path(line: text) -> text = split(line, tab())[0]
public define entry_blob(line: text) -> text = split(line, tab())[1]

# En radfil som TABELL, och tillbaka. Samma skal som stat_karta har: en
# linjar sokning per fil ar n kvadrat over tradet, och index, manifest och
# lasfil har alla sokvagen forst.
define karta_av(lines: [text]) -> table of text:
    edit m: table of text = {}
    loop l in lines:
        m[entry_path(l)] = entry_blob(l)
    m

# Sorterad pa sokvag. Samma trad MASTE ge samma manifest-id, och manifestet
# ar de har raderna ordagrant.
#
# Parametrarna star ANNOTERADE som text med flit. Utan annotering blir de
# `int` och jamforelsen tittar pa pekarna, sa `sorted` lamnade listan i den
# ordning den kom in. Det syntes inte sa lange ordningen kom fran en fil,
# men ur en tabell ar den inte given.
define rader_av(m: table of text) -> [text]:
    edit out = []
    loop path, blob in m:
        out = append(out, path + tab() + blob)
    sorted(out, order_of{less: (a: text, b: text): a < b})

# Vardet i en tabell, "" nar nyckeln saknas.
define vid(m: table of text, key: text) -> text:
    if has(m, key) then m[key] else ""

# En BORTTAGNING i kon. Kon ar "det som andrats sedan sist", sa tystnad om
# en fil betyder oror - darfor maste ett borttagande sagas rakt ut. "-" ar
# samma tecken som en commit utan foralder anvander.
define borttagen() -> text = "-"

# Skriv kon: `rels` far sitt innehall lagrat, `borta` far en markering.
# Indexet och lasfilen lases, sorteras och skrivs EN gang. Per fil blev det
# n kvadrat i bade sortering och disk-IO: 1600 filer tog 34 sekunder for
# det som ar en vandring. Returnerar de sokvagar nagon ANNAN haller.
# Vad en koning gjorde. Bada halvorna behovs pa bada stallena - CLI:t
# skriver "koade N" och doten svarar med samma tva tal - och att lata dem
# rakna om antalet sjalva hade betytt en vandring till over tradet.
public type Koat: antal: number, last: [text], fel: [text]

define stage(root: text, rels: [text], borta: [text], owner: text) -> Koat uses files:
    rd = rune_dir(root)
    # EN pack for hela vandan i stallet for tva filer per fil.
    writer_open(root)
    defer writer_close()
    edit idx = karta_av(read_lines(rd + "/index"))
    hallare = karta_av(read_locks(root))
    edit blocked = []
    edit fel = []
    loop rel in rels:
        held = vid(hallare, rel)
        if not is_empty(held) and held is not owner:
            blocked = append(blocked, rel)
        else:
            blob = put_file(rd, root + "/" + rel)
            # Kom den inte i lagret ska den inte in i kon heller. En kopost
            # som pekar pa ett objekt som inte finns ar en commit som inte
            # gar att checka ut.
            if is_empty(blob):
                fel = append(fel, rel)
            else:
                idx[rel] = blob
    loop p in borta:
        who = vid(hallare, p)
        if not is_empty(who) and who is not owner:
            blocked = append(blocked, p)
        else:
            idx[p] = borttagen()
    write_lines(rd + "/index", rader_av(idx))
    Koat{antal: length(rels) + length(borta) - length(blocked) - length(fel), last: blocked, fel: fel}

# Koa namngivna sokvagar.
public define add(root: text, rels: [text], owner: text) -> Koat uses files:
    stage(root, rels, [], owner)

# Koa hela tradet: allt som finns, och en markering for det som fanns i
# HEAD men inte langre pa disken. Den ar den enda som kan se en
# borttagning, for den ar den enda som vet vad som INTE finns.
public define add_tree(root: text, owner: text) -> Koat uses files:
    finns = walk(root)
    edit pa_disk: table of text = {}
    loop rel in finns:
        pa_disk[rel] = ""
    head = head_commit(root)
    edit borta = []
    loop line in (if is_empty(head) then [] else commit_manifest(root, head)):
        pp = entry_path(line)
        if not has(pa_disk, pp):
            borta = append(borta, pp)
    stage(root, finns, borta, owner)

# --- refs och commits ---------------------------------------------------
public define head_ref(root: text) -> text uses files:
    read_file(rune_dir(root) + "/HEAD")

public define head_commit(root: text) -> text uses files:
    p = rune_dir(root) + "/" + head_ref(root)
    if file_exists(p) is 0 then "" else read_file(p)

public define commit(root: text, msg: text, author: text) -> text uses files, clock:
    rd = rune_dir(root)
    idx = read_lines(rd + "/index")
    if length(idx) is 0:
        return ""
    # Ogonblicksbilden ar HEAD PLUS kon, inte kon i sig. Kon ar det som
    # andrats sedan sist och toms efter varje commit; togs den for hela
    # bilden forsvann allt man INTE koade ur historien: `rune add en.fil`
    # och commit gav en commit som bara innehall den enda filen.
    edit bild = karta_av(commit_manifest(root, head_commit(root)))
    loop l in idx:
        if entry_blob(l) is borttagen():
            bild = map_remove(bild, entry_path(l))
        else:
            bild[entry_path(l)] = entry_blob(l)
    id = write_commit(root, bild, author, msg)
    write_file(rd + "/index", "")
    id

# Skriv manifestet, commiten och refen. Delad av `commit`, som bygger
# bilden ur kon, och av `commit_file`, som byter EN sokvag. Bara den forra
# ror kon - servern har ingen att ro ur.

define write_commit(root: text, bild: table of text, author: text, msg: text) -> text uses files, clock:
    rd = rune_dir(root)
    manifest = put_object(rd, "manifests", join(rader_av(bild), "\n"))
    parent = head_commit(root)
    par = if is_empty(parent) then "-" else parent
    nl = text_of([10])
    body = "parent {par}" + nl + "manifest {manifest}" + nl + "author {author}" + nl + "time {now_unix()}" + nl + nl + msg
    id = put_object(rd, "commits", body)
    if is_empty(manifest) or is_empty(id):
        return ""
    write_file(rd + "/" + head_ref(root), id)
    id

# Ett falt ur en commit-kropp: raden som borjar med `name `, utan prefixet.
public define commit_field(body: text, name: text) -> text:
    edit found = ""
    loop line in split(body, "\n"):
        if starts_with(line, name + " ") and is_empty(found):
            found = text_of(bytes_part(bytes_of(line), byte_count(name) + 1, byte_count(line)))
    found

public define commit_message(body: text) -> text:
    parts = split(body, "\n\n")
    if length(parts) < 2 then "" else join(drop_first(parts), "\n\n")

define drop_first(xs: [text]) -> [text]:
    edit out = []
    loop i in 1 until length(xs):
        out = append(out, xs[i])
    out

# Commit-kedjan fran HEAD och bakat, nyast forst.
public define log(root: text) -> [text] uses files:
    edit out = []
    edit id = head_commit(root)
    loop:
        if is_empty(id) or id is "-":
            break
        out = append(out, id)
        id = commit_field(get_object(rune_dir(root), "commits", id), "parent")
    out

# Manifestets rader for en commit.
public define commit_manifest(root: text, id: text) -> [text] uses files:
    rd = rune_dir(root)
    m = commit_field(get_object(rd, "commits", id), "manifest")
    if is_empty(m):
        return []
    edit out = []
    loop line in split(get_object(rd, "manifests", m), "\n"):
        if not is_empty(line):
            out = append(out, line)
    out

# Skriv ut hela ogonblicksbilden ur en commit till arbetstradet.
# Antal skrivna filer, eller -1 om nagot saknas i lagret. Vid -1 ar INGET
# skrivet: en halv utcheckning ar varre an ingen.
public define checkout(root: text, id: text) -> number uses files:
    rader = commit_manifest(root, id)
    loop line in rader:
        if not blob_complete(rune_dir(root), entry_blob(line)):
            return 0 - 1
    edit n = 0
    loop line in rader:
        skrev = get_file(rune_dir(root), entry_blob(line), root + "/" + entry_path(line))
        n = n + 1
    n

# Ett fullstandigt commit-id ur ett prefix. `rune log` visar tolv tecken
# och `checkout` kravde alla sextiofyra, sa verktygets egen utskrift gick
# inte att klistra in i verktygets eget kommando.
#
# "" bade nar inget matchar och nar FLERA gor det. Att gissa vilken commit
# nagon menade ar inte rune:s sak; skriv fler tecken.
public define resolve(root: text, prefix: text) -> text uses files:
    if is_empty(prefix):
        return ""
    edit hit = ""
    edit n = 0
    loop id in log(root):
        if starts_with(id, prefix):
            hit = id
            n = n + 1
    if n is 1 then hit else ""

# Gor arbetstradet LIKA med en ogonblicksbild: skriv det som ska finnas,
# ta bort det som inte ska. Antal skrivna, eller -1 om nagot saknas i
# lagret - da rors ingenting.
#
# Skillnaden mot checkout ar borttagningen, och den ar farlig nog att bara
# ha en anropare: `pull`, som forst har krävt ett rent trad. Filer som
# .runeignore haller utanfor rors inte, for walk ser dem inte.
public define write_tree(root: text, id: text) -> number uses files:
    rader = commit_manifest(root, id)
    loop line in rader:
        if not blob_complete(rune_dir(root), entry_blob(line)):
            return 0 - 1
    edit ska: table of text = {}
    loop line in rader:
        ska[entry_path(line)] = entry_blob(line)
    loop rel in walk(root):
        if not has(ska, rel):
            skydd = set_readonly(root + "/" + rel, false)
            togs = remove_file(root + "/" + rel)
    edit n = 0
    loop line in rader:
        skrev = get_file(rune_dir(root), entry_blob(line), root + "/" + entry_path(line))
        n = n + 1
    n

# Blob-id for en sokvag i en radlista, "" om sokvagen inte finns dar.
define lookup(lines: [text], path: text) -> text:
    edit found = ""
    loop l in lines:
        if entry_path(l) is path:
            found = entry_blob(l)
    found

# Namnet som skriver commiten. Miljon, annars "okand" - ingen inloggning,
# ingen konfigurationsfil att glomma.
public define author_name() -> text uses env:
    u = env("USERNAME")
    if not is_empty(u):
        return u
    v = env("USER")
    if is_empty(v) then "okand" else v

# --- las ----------------------------------------------------------------
# En .uasset gar inte att sla ihop. Da ar las enda arbetssattet: den som
# ska andra en fil tar den forst, och alla andra ser att den ar tagen.
#
#   .rune/locks    "sokvag<TAB>agare<TAB>unixtid", en per rad, sorterad
#
# Laset ar SPARRET, inte en varning: `add` vagrar koa en sokvag nagon annan
# haller. Darfor bor kontrollen i add och inte i CLI:t - annars gar den att
# ga runt genom att anropa lagret direkt.
#
# Sa lange det inte finns nagon remote ar lasen lokala. Formatet ar dock
# det som ska synkas, och sparret ar det som maste finnas fore en remote.

define locks_path(root: text) -> text = rune_dir(root) + "/locks"

public define read_locks(root: text) -> [text] uses files:
    read_lines(locks_path(root))

public define lock_holder(line: text) -> text = split(line, tab())[1]

# Vem haller sokvagen, "" om den ar ledig.
public define lock_owner(root: text, path: text) -> text uses files:
    edit found = ""
    loop l in read_locks(root):
        if entry_path(l) is path:
            found = lock_holder(l)
    found

define write_locks(root: text, lines: [text]) uses files:
    write_lines(locks_path(root), lines)

# Ta sokvagen. "" nar den ar din efterat, annars namnet som redan haller
# den. Att ta en du redan haller ar tyst ok.
public define lock(root: text, path: text, owner: text) -> text uses files, clock:
    held = lock_owner(root, path)
    if not is_empty(held):
        return if held is owner then "" else held
    line = path + tab() + owner + tab() + (now_unix() as text)
    write_locks(root, sorted(append(read_locks(root), line), order_of{less: (a: text, b: text): a < b}))
    ""

# Slapp sokvagen. "" nar den ar ledig efterat, annars namnet som haller
# den - man tar inte nagon annans las ifran dem.
public define unlock(root: text, path: text, owner: text) -> text uses files:
    held = lock_owner(root, path)
    if is_empty(held):
        return ""
    if held is not owner:
        return held
    edit kept = []
    loop l in read_locks(root):
        if entry_path(l) is not path:
            kept = append(kept, l)
    write_locks(root, kept)
    ""

# Skrivskyddet pa disk foljer lasen: en fil nagon ANNAN haller gar inte att
# spara over i det program man faktiskt ritar i. Sparret i `add` kommer
# forst nar jobbet redan ar gjort - det har sager ifran innan man borjar.
#
# `forra` ar lastabellen som gallde innan. Sokvagar som fanns dar men inte
# langre ar lasta far tillbaka sin skrivratt; utan den halvan hade en
# slappt fil legat kvar skrivskyddad tills nagon gissade varfor.
public define apply_locks(root: text, me: text, forra: [text]) uses files:
    nu = karta_av(read_locks(root))
    loop l in forra:
        p = entry_path(l)
        if not has(nu, p):
            fritt = set_readonly(root + "/" + p, false)
    loop p, agare in nu:
        st = set_readonly(root + "/" + p, agare is not me)

# --- att SKRIVA in i lagret utifran --------------------------------------
# Ett innehall in, en commit ut. Ingen ko inblandad, och det ar avsiktligt:
# kon ar en delad fil, och en server som stagar at en klient hade lagt
# nagon annans halvfardiga arbete i din commit. En skrivning ar en commit.

public type Skrivet: id: text, fel: text

# Skriv en sokvag och committa den. Lassparren ligger HAR och inte i den
# som svarar pa requesten - annars gar den att ga runt genom att anropa
# lagret direkt, precis som for `add`.
#
# Ar innehallet redan det HEAD har blir det ingen commit. En redigerare
# som sparar utan att ha andrat nagot ska inte fylla historien.
public define commit_file(root: text, rel: text, fran: text, author: text, msg: text) -> Skrivet uses files, clock:
    held = lock_owner(root, rel)
    if not is_empty(held) and held is not author:
        return Skrivet{id: "", fel: "last av {held}"}
    rd = rune_dir(root)
    huvud = head_commit(root)
    edit bild = karta_av(commit_manifest(root, huvud))
    # `fran` ar en FIL och inte ett innehall: den som tar emot skrivningen
    # lade den pa disk medan den kom in, sa put_file kan stromma genom sitt
    # fonster. Ett innehall i minnet hade kostat atta byte per byte.
    blob = put_file(rd, fran)
    borta = remove_file(fran)
    if is_empty(blob):
        return Skrivet{id: "", fel: "kunde inte lagras"}
    if vid(bild, rel) is blob:
        return Skrivet{id: huvud, fel: ""}
    bild[rel] = blob
    id = write_commit(root, bild, author, msg)
    if is_empty(id):
        return Skrivet{id: "", fel: "kunde inte lagras"}
    Skrivet{id: id, fel: ""}

# --- att lasa ur lagret utifran ------------------------------------------
# Innehallsadressering ger SLUMPVIS LASNING gratis. Ett recept plus
# storleken pa varje chunkfil sager var varje chunk borjar, och da behover
# bara de chunkar som TACKER intervallet oppnas. Ingen seek, ingen
# genomlasning, och det spelar ingen roll om filen ar 200 MB.
#
# Det ar det som gor att rune kan vara ett LAGER under nagon annans
# program i stallet for ett verktyg bredvid det.

# Fanns sokvagen i den commiten? Billigare an att fraga efter storleken
# nar man anda inte behover den.
public define has_path(root: text, id: text, rel: text) -> truth uses files:
    not is_empty(lookup(commit_manifest(root, id), rel))

# Filens storlek vid en commit, utan att lasa den.
public define file_size_at(root: text, id: text, rel: text) -> number uses files:
    rd = rune_dir(root)
    blob = lookup(commit_manifest(root, id), rel)
    if is_empty(blob):
        return 0 - 1
    edit n = 0
    loop cid in blob_chunks(rd, blob):
        n = n + object_size(rd, "chunks", cid)
    n

# Bytes [from, to) ur filen vid en commit, som BITAR i ordning. Tom lista
# om sokvagen inte fanns da. `to` bortom filens slut ar inget fel.
#
# Bitar och inte en fardig text: den som skickar dem kan skriva ut dem en
# och en, och da behover hela svaret aldrig ligga hopfogat i minnet. Att
# foga ihop 20 MB ur 320 bitar kostade 200 MB som aldrig lamnades tillbaka.
public define file_parts(root: text, id: text, rel: text, from: number, to: number) -> [text] uses files:
    rd = rune_dir(root)
    blob = lookup(commit_manifest(root, id), rel)
    if is_empty(blob) or to <= from:
        return []
    edit bitar = []
    edit at = 0
    loop cid in blob_chunks(rd, blob):
        if at >= to:
            break
        # Storleken kommer ur filsystemet, inte ur innehallet. Att hitta
        # offset for chunk k kostar alltsa k STORLEKSFRAGOR och noll
        # lasningar - kostnaden foljer receptet, inte filens bytes.
        langd = object_size(rd, "chunks", cid)
        slut = at + langd
        if slut > from:
            hel = get_object(rd, "chunks", cid)
            # Bara chunkarna i KANTERNA skivas. En chunk som ligger helt
            # inne i intervallet gar in som den ar, och slipper darmed
            # byteslistan - som kostar atta byte per byte.
            if at >= from and slut <= to:
                bitar = append(bitar, hel)
            else:
                b = bytes_of(hel)
                borjan = if from > at then from - at else 0
                slutet = if to < slut then to - at else langd
                bitar = append(bitar, text_of(bytes_part(b, borjan, slutet)))
        at = slut
    bitar

# --- skrapet -------------------------------------------------------------
# Ett `add` som aldrig blev en commit lamnar sina chunkar kvar, och det ar
# inte sallan: man sparar, koar, sparar igen, koar igen. Matt pa tre add
# och en commit: 28 objekt i lagret dar 7 behovdes.
#
# `pack` ar det som stadar. Den skriver om det NABARA och lamnar resten,
# sa skrap forsvinner som en foljd av att lagret skrivs om - det behovs
# ingen egen gc bredvid.

define mark_blob(rd: text, blob: text, set: table of text) -> table of text uses files:
    edit m = set
    m["blobs/" + blob] = ""
    loop cid in blob_chunks(rd, blob):
        m["chunks/" + cid] = ""
    m

# Allt som gar att na. Kedjan bakat fran HEAD, och KON: det som ar koat men
# inte committat far inte stadas bort under fotterna pa den som koade det.
public define reachable(root: text) -> table of text uses files:
    rd = rune_dir(root)
    edit set: table of text = {}
    loop id in log(root):
        set["commits/" + id] = ""
        man = commit_field(get_object(rd, "commits", id), "manifest")
        if not is_empty(man):
            set["manifests/" + man] = ""
            loop rad in commit_manifest(root, id):
                set = mark_blob(rd, entry_blob(rad), set)
    loop l in read_lines(rd + "/index"):
        if entry_blob(l) is not borttagen():
            set = mark_blob(rd, entry_blob(l), set)
    set

# Alla losa objekt som "sort/id".
define losa(rd: text) -> [text] uses files:
    edit ut = []
    loop sort in ["chunks", "blobs", "manifests", "commits"]:
        mapp = rd + "/" + sort
        if is_dir(mapp) is not 0:
            loop d in list_dirs(mapp):
                if not is_empty(d):
                    loop f in list_dir(mapp + "/" + d):
                        if not is_empty(f):
                            ut = append(ut, sort + "/" + d + f)
    ut

# Skriv om allt NABART till en enda pack och ta bort resten. Antal packade
# objekt, eller -1 om packen inte gick att skriva.
#
# Packar bara det nabara, sa skrap kommer aldrig in i en pack - det ar
# darfor det inte behovs nagon gc FOR packar. Gamla packar och losa objekt
# tas bort efterat, aldrig fore: gar skrivningen fel star repot kvar som
# det var.
public define pack(root: text) -> number uses files:
    rd = rune_dir(root)
    lever = reachable(root)
    # Nycklarna samlas FORE arenan slas pa - listan maste overleva svepen.
    edit nycklar = []
    loop k, v in lever:
        nycklar = append(nycklar, k)
    gamla = if is_dir(pack_dir(rd)) is not 0 then list_dir(pack_dir(rd)) else []
    lossa = losa(rd)
    mkdir_all(pack_dir(rd))
    ny = pack_dir(rd) + "/" + (length(gamla) + 1 as text)
    h = open_write(ny + ".pack")
    if not ok(h):
        return 0 - 1
    edit rader = []
    edit at = 0
    edit n = 0
    pa = arena_on()
    loop k in nycklar:
        d = split(k, "/")
        kropp = get_object(rd, d[0], d[1])
        ra = bytes_count(kropp)
        # Komprimera, men bara om det vann. En redan komprimerad asset
        # vaxer av ett forsok till, och da lagras den rakt av.
        liten = squeeze(kropp)
        vinst = bytes_count(liten) < ra
        lagra = if vinst then liten else kropp
        langd = if vinst then bytes_count(liten) else ra
        skrev = write_chunk(h, lagra)
        rad = persisted(d[1] + tab() + d[0] + tab() + (at as text) + tab() + (langd as text) + tab() + (ra as text))
        was = persist_on()
        rader = append(rader, rad)
        persist_off(was)
        at = at + langd
        n = n + 1
        svept = arena_reset()
    av = arena_off()
    stangd = close(h)
    write_lines(ny + ".idx", rader)
    # Forst nu ar det tryggt att slappa det gamla.
    loop f in gamla:
        if not is_empty(f):
            togs = remove_file(pack_dir(rd) + "/" + f)
    loop k in lossa:
        d = split(k, "/")
        togs = remove_file(object_path(rd, d[0], d[1]))
    # Och de tomma mapparna. Tva hex som mapp ger upp till 256 per sort, och
    # en tom mapp kostar ett kluster precis som en fil: tusen av dem var
    # fyra megabyte av de sju som lag kvar efter packningen.
    loop sort in ["chunks", "blobs", "manifests", "commits"]:
        if is_dir(rd + "/" + sort) is not 0:
            bort = remove_tree(rd + "/" + sort)
    n

# --- lagrets sundhet ----------------------------------------------------
# Varje objekts INNEHALL mot dess NAMN. Namnet ar hashen av innehallet, sa
# den jamforelsen ar hela sanningen: stammer den inte ar filen inte det
# objektet, oavsett hur den blev sa.
#
# Rader "sort<TAB>id" for dem som inte stammer. Tomt betyder sunt lager.
#
# `put_object` ska gora det har omojligt for nya objekt - den tar bort en
# skrivning som inte gick igenom. Det har ar for det som redan hant, och
# for diskar som tappar bytes langt efter att de skrevs.
public define fsck(root: text) -> [text] uses files:
    rd = rune_dir(root)
    edit trasiga = []
    # Bade de losa och de packade. Efter en `pack` ar objektmapparna TOMMA,
    # och en fsck som bara tittade dar sa "sunt" utan att ha last nagot.
    loop k in losa(rd):
        d = split(k, "/")
        if sha256(read_file(object_path(rd, d[0], d[1]))) is not d[1]:
            trasiga = append(trasiga, d[0] + tab() + d[1])
    loop k, v in pack_index(rd):
        d = split(k, "/")
        if sha256(from_pack(rd, d[0], d[1])) is not d[1]:
            trasiga = append(trasiga, d[0] + tab() + d[1])
    trasiga

# --- fragor som en yta behover ------------------------------------------

# Filens versioner, nyast forst: en rad per DISTINKT innehall, markt med
# den nyaste commit som bar det. Rader "commit<TAB>unixtid<TAB>blob".
public define file_history(root: text, rel: text) -> [text] uses files:
    rd = rune_dir(root)
    edit out = []
    edit seen = ""
    loop id in log(root):
        blob = lookup(commit_manifest(root, id), rel)
        if not is_empty(blob) and blob is not seen:
            when = commit_field(get_object(rd, "commits", id), "time")
            out = append(out, id + tab() + when + tab() + blob)
            seen = blob
    out

# Filens innehall vid en commit, "" om den inte fanns da.
public define file_at(root: text, id: text, rel: text) -> text uses files:
    blob = lookup(commit_manifest(root, id), rel)
    if is_empty(blob) then "" else blob_bytes(rune_dir(root), blob)

# --- statcachen -----------------------------------------------------------
# `status` hashade om HELA arbetstradet varje gang. Filen laser vi anda,
# men chunkningen och hashningen ar det dyra, och for en fil som inte rort
# sig ar den ren spillan.
#
# Cachen bor i EGEN fil och inte i indexet: indexet haller bara KOADE
# filer, och det ar just de okoade som ar manga och kostar tid.
#
#   .rune/stat    "sokvag<TAB>mtime<TAB>storlek<TAB>blob-id", en per rad
#
# GRANSEN, uttalad: andras en fil inom samma mtime-tick OCH behaller exakt
# samma storlek tror cachen att den ar oforandrad. Det ar samma kapplopning
# git har, och den syns forst nasta gang mtime rors. `rune add <fil>` gar
# alltid forbi cachen, sa det finns en vag runt.
define stat_path(root: text) -> text = rune_dir(root) + "/stat"

define stat_nyckel(root: text, rel: text) -> text uses files:
    p = root + "/" + rel
    (modified_at(p) as text) + tab() + (size_of(p) as text)

# Cachen som en TABELL, inte en lista att leta i. En linjar sokning per fil
# gav n kvadrat over tradet: 10 000 filer hade blivit hundra miljoner
# jamforelser, alltsa dyrare an hashningen cachen skulle slippa undan.
define stat_karta(root: text) -> table of text uses files:
    edit m: table of text = {}
    loop l in read_lines(stat_path(root)):
        f = split(l, tab())
        if length(f) >= 4:
            m[f[0]] = f[1] + tab() + f[2] + tab() + f[3]
    m

# Blob-id om mtime och storlek stammer, annars "".
define stat_traff(m: table of text, rel: text, nyckel: text) -> text:
    if not has(m, rel):
        return ""
    f = split(m[rel], tab())
    if length(f) >= 3 and (f[0] + tab() + f[1]) is nyckel then f[2] else ""

# Arbetstradet mott kon och mot HEAD. Rader "tillstand<TAB>sokvag", dar
# tillstand ar koat, nytt, andrat eller borttaget. Oforandrade filer namns
# inte alls. EN definition av vad status betyder, delad av CLI och yta -
# annars sager de tva olika saker om samma trad.
public define status(root: text) -> [text] uses files:
    idx = karta_av(read_lines(rune_dir(root) + "/index"))
    head = head_commit(root)
    snapshot = if is_empty(head) then [] else commit_manifest(root, head)
    snap = karta_av(snapshot)
    cache = stat_karta(root)
    edit fardsk = []
    edit rows = []
    edit seen: table of text = {}
    loop rel in walk(root):
        nyckel = stat_nyckel(root, rel)
        edit cur = stat_traff(cache, rel, nyckel)
        if is_empty(cur):
            cur = file_blob_id(root + "/" + rel)
        fardsk = append(fardsk, rel + tab() + nyckel + tab() + cur)
        seen[rel] = ""
        staged = vid(idx, rel)
        committed = vid(snap, rel)
        if staged is cur:
            rows = append(rows, "koat" + tab() + rel)
        else if is_empty(committed):
            rows = append(rows, "nytt" + tab() + rel)
        else if committed is not cur:
            rows = append(rows, "andrat" + tab() + rel)
    loop line in snapshot:
        p = entry_path(line)
        if not has(seen, p):
            rows = append(rows, (if vid(idx, p) is borttagen() then "koat" else "borttaget") + tab() + p)
    write_lines(stat_path(root), fardsk)
    rows

# Finns texten i listan? Delas med rune_remote, som annars hade haft en
# egen kopia under ett annat namn.
public define has_text(xs: [text], v: text) -> truth:
    edit hit = false
    loop x in xs:
        if x is v:
            hit = true
    hit
