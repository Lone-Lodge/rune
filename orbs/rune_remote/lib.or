# rune_remote - servern och klienten.
#
# Hela synken ar en fraga: VILKA ID SAKNAR DU? Det ar innehallsadresseringens
# hela utdelning. Ingen jamforelse av trad, inga deltan att rakna ut, ingen
# forhandling. Klienten raknar upp vad den har, servern svarar vad den
# saknar, och bara det gar over tradet.
#
# Egen HTTP pa net-orben istallet for app-orben: app splittar hela requesten
# pa "\r\n\r\n" och tar andra biten som kropp, sa en binar kropp som RAKAR
# innehalla den sekvensen kapas. Chunkar ar rakt innehall ur .uasset-filer
# och gor det forr eller senare. Har lases exakt Content-Length bytes.
#
#   POST /have?sort=chunks   ids, en per rad   -> de servern SAKNAR
#   GET  /obj/<sort>/<id>                      -> objektets bytes
#   PUT  /obj/<sort>/<id>    objektets bytes
#   GET  /ref                                  -> commit-id, "" om tomt
#   POST /ref                "gammal\nny"      -> "ok", annars "stale <nu>"
#   GET  /locks                                -> lasfilen som den ar
#   POST /lock               "vag\nagare"      -> "" om din, annars hallaren
#   POST /unlock             "vag\nagare"      -> "" om ledig, annars hallaren

use rune
# Bara de tre: `ok` och `close` heter samma sak i net, och det ar
# SOCKETARNAS som ska galla har.
use file (open_write, write_chunk, close_file)
use net
use os
use text
use encoding

define crlf() -> text = text_of([13, 10])
define head_end() -> text = text_of([13, 10, 13, 10])

# --- server -------------------------------------------------------------

# Las tills hela huvudet kommit, och sedan exakt sa manga bytes kroppen
# lovade.
#
# En SKRIVNING gar rakt till disk medan den tas emot. Alla andra kroppar ar
# sma - en idlista, en ref, en lasrad, en chunk - och far ligga i minnet.
# Att bygga en stor kropp i minnet kostade tjugo ganger sin egen storlek
# och lamnades aldrig tillbaka: en 20 MB-kropp tog servern till 400 MB,
# och sex av dem till 2,6 GB.
type Request: head: text, body: text, fil: text

define read_request(conn: number, root: text) -> Request uses net, files:
    edit raw = ""
    loop:
        if contains(raw, head_end()):
            break
        chunk = recv(conn, 65536)
        if timed_out(chunk) or chunk is "":
            return Request{head: "", body: "", fil: ""}
        raw = raw + chunk
    rb = bytes_of(raw)
    cut = find_head_end(rb)
    head = text_of(bytes_part(rb, 0, cut))
    want = content_length(head)
    forst = text_of(bytes_part(rb, cut + 4, bytes_count(rb)))
    if till_disk(head):
        return Request{head: head, body: "", fil: stromma(conn, root, forst, want)}
    edit bitar = [forst]
    edit har = byte_count(forst)
    loop:
        if har >= want:
            break
        more = recv(conn, 65536)
        if timed_out(more) or more is "":
            break
        bitar = append(bitar, more)
        har = har + byte_count(more)
    hel = join(bitar, "")
    # Skivas bara om vi faktiskt fick for mycket. Normalfallet ar exakt
    # ratt manga bytes, och da ror vi inte kroppen alls.
    Request{head: head, body: if har > want then text_of(bytes_part(bytes_of(hel), 0, want)) else hel, fil: ""}

# Ar det en skrivning? Beslutet tas ur HUVUDET, alltsa innan kroppen ens
# borjat lasas - det ar hela poangen med att lasa huvudet forst.
define till_disk(head: text) -> truth:
    rl = request_line(head)
    if length(rl) < 2:
        return false
    rl[0] is "POST" and length(segments(rl[1])) is 1 and segments(rl[1])[0] is "file"

# Kroppen till en fil, block for block. Sokvagen ut, eller "" om nagot gick
# fel. Namnet ar fast: servern tar en request i taget.
define stromma(conn: number, root: text, forst: text, want: number) -> text uses net, files:
    ut = rune_dir(root) + "/inkommande"
    h = open_write(ut)
    if not ok(h):
        return ""
    defer close_file(h)
    # Rakningen kommer ur write_chunk, som anda sager hur manga bytes den
    # skrev. `byte_count` hade varit det uppenbara valet men gor en
    # byteslista av sitt argument - atta byte per byte, en gang per
    # mottaget block. Det ensamt var 160 MB per 20 MB-kropp.
    edit har = if is_empty(forst) then 0 else write_chunk(h, forst)
    loop:
        if har >= want:
            break
        more = recv(conn, 65536)
        if timed_out(more) or more is "":
            break
        skrev = write_chunk(h, more)
        if skrev < 0:
            return ""
        har = har + skrev
    if har is want then ut else ""

# Offset for "\r\n\r\n" i bytes. -1 om den inte finns.
define find_head_end(b: [number]) -> number:
    n = bytes_count(b)
    edit at = 0 - 1
    loop i in 0 until n - 3:
        if at < 0 and byte_at(b, i) is 13 and byte_at(b, i + 1) is 10 and byte_at(b, i + 2) is 13 and byte_at(b, i + 3) is 10:
            at = i
    at

# Ett huvudes varde, "" om det saknas. Allt EFTER forsta kolonet, sa ett
# varde som sjalvt innehaller kolon overlever.
define header_value(head: text, name: text) -> text:
    edit found = ""
    loop line in split(head, crlf()):
        kv = split(line, ":")
        if length(kv) > 1 and lower(trim(kv[0])) is name and is_empty(found):
            found = trim(text_of(bytes_part(bytes_of(line), byte_count(kv[0]) + 1, byte_count(line))))
    found

define content_length(head: text) -> number:
    v = header_value(head, "content-length")
    if is_empty(v) then 0 else int_from_text(v)

define request_line(head: text) -> [text] = split(split(head, crlf())[0], " ")

# --- hemligheten --------------------------------------------------------
# En delad hemlighet per repo. Den ar en DORRNYCKEL och inte en identitet:
# den sager att du far tala med servern, inte VEM du ar. Lasen bar
# fortfarande ett namn som klienten sjalv anger, sa den som har nyckeln kan
# ange vilket namn som helst. Det racker for ett lag som redan litar pa
# varandra. Det racker inte mot oppna natet.
#
# Bor i .rune/secret, alltsa i mappen git redan haller utanfor.

define secret_path(root: text) -> text = rune_dir(root) + "/secret"

public define secret(root: text) -> text uses files:
    p = secret_path(root)
    if file_exists(p) is 0 then "" else trim(read_file(p))

public define set_secret(root: text, s: text) uses files:
    write_file(secret_path(root), trim(s))

# Jamfor HASHARNA och inte varden: bada blir da lika langa, sa langden pa
# den ratta hemligheten lacker inte ut genom nar ett nej kommer.
define secret_ok(root: text, given: text) -> truth uses files:
    sha256(given) is sha256(secret(root))

# "Bearer xyz" -> "xyz".
define bearer(head: text) -> text:
    v = header_value(head, "authorization")
    if starts_with(v, "Bearer ") then trim(text_of(bytes_part(bytes_of(v), 7, byte_count(v)))) else ""

# send_raw och INTE send: net.send tar langden med strlen och kapar darfor
# vid forsta nollbyten. Ett svar med en chunk ur en .uasset kom fram som
# sina forsta trehundra bytes, och pullen skrev tyst en trasig fil.
define answer_code(conn: number, code: number, reason: text, bitar: [text]) uses net:
    edit n = 0
    loop b in bitar:
        n = n + bytes_count(b)
    head = "HTTP/1.1 {code} {reason}" + crlf() + "Content-Length: {n}" + crlf() + "Content-Type: application/octet-stream" + crlf() + "Connection: close" + crlf() + crlf()
    sent = send_raw(conn, head)
    # En bit i taget ut. Att foga ihop dem forst hade byggt hela svaret i
    # minnet igen, och det var precis det bitarna finns for att slippa.
    loop b in bitar:
        skickat = send_raw(conn, b)

# Sokvagens segment efter den ledande snedstrecket.
define segments(path: text) -> [text]:
    edit out = []
    loop s in split(split(path, "?")[0], "/"):
        if not is_empty(s):
            out = append(out, s)
    out

define query_arg(path: text, name: text) -> text:
    parts = split(path, "?")
    if length(parts) < 2:
        return ""
    edit found = ""
    loop pair in split(parts[1], "&"):
        kv = split(pair, "=")
        if length(kv) > 1 and kv[0] is name:
            found = kv[1]
    found

# Sorterna ar en sluten lista. En sokvag utifran far aldrig valja mapp fritt.
define known_sort(s: text) -> truth:
    s is "chunks" or s is "blobs" or s is "manifests" or s is "commits"

# Ett id maste vara 64 hex. Det ar bade en riktighetskontroll och sparret
# mot att en sokvag klattrar ur objektmappen.
define safe_id(id: text) -> truth:
    b = bytes_of(id)
    if bytes_count(b) is not 64:
        return false
    edit ok = true
    loop i in 0 until 64:
        c = byte_at(b, i)
        if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)):
            ok = false
    ok

# Ett svar bar sin KOD, inte bara sin kropp. Utan koden gar "filen fanns
# inte" inte att skilja fran "filen ar tom", och det ar precis den
# skillnaden en lasare utifran behover.
# Kroppen ar BITAR i ordning, inte en fardig text. Ett filsvar kan da
# skrivas ut bit for bit, och behover aldrig ligga hopfogat i minnet.
type Svar: kod: number, bitar: [text]

define ok_svar(kropp: text) -> Svar = Svar{kod: 200, bitar: [kropp]}
define fel_svar(kod: number, kropp: text) -> Svar = Svar{kod: kod, bitar: [kropp]}

define reason_of(kod: number) -> text:
    if kod is 200:
        "OK"
    else if kod is 404:
        "Not Found"
    else if kod is 409:
        "Conflict"
    else:
        "Error"

# %20 och slaktingar. En sokvag ur en fragestrang kan bara vad som helst.
define pct(head: text) -> number:
    edit v = 0
    loop i in 0 until 2:
        c = byte_at(bytes_of(head), i)
        d = if c >= 48 and c <= 57 then c - 48 else (if c >= 97 and c <= 102 then c - 87 else (if c >= 65 and c <= 70 then c - 55 else 0 - 1))
        if d < 0:
            return 0 - 1
        v = v * 16 + d
    v

define url_decode(t: text) -> text:
    b = bytes_of(t)
    n = bytes_count(b)
    edit ut = []
    edit i = 0
    loop:
        if i >= n:
            break
        c = byte_at(b, i)
        if c is 37 and i + 2 < n:
            v = pct(text_of(bytes_part(b, i + 1, i + 3)))
            if v < 0:
                ut = append(ut, c)
                i = i + 1
            else:
                ut = append(ut, v)
                i = i + 3
        else:
            ut = append(ut, if c is 43 then 32 else c)
            i = i + 1
    text_of(ut)

# `at` far vara ett forkortat commit-id, eller utelamnas for HEAD.
define at_commit(root: text, at: text) -> text uses files:
    if is_empty(at) then head_commit(root) else resolve(root, at)

# Radsvar SLUTAR med radbrytning. Objektkroppar gor det inte - de ligger
# under en hash och en byte till hade andrat varje id - men det har ar ett
# svar till nagon annans program, och en avslutad sista rad ar vad varje
# radlasare forvantar sig.
define rader_svar(rader: [text]) -> text:
    if length(rader) is 0 then "" else join(rader, "\n") + text_of([10])

define tal(t: text, standard: number) -> number:
    if is_empty(t) then standard else int_from_text(t)

define handle(root: text, req: Request) -> Svar uses files, clock:
    head = req.head
    body = req.body
    rl = request_line(head)
    if length(rl) < 2:
        return ok_svar("")
    method = rl[0]
    path = rl[1]
    seg = segments(path)
    rd = rune_dir(root)

    if method is "POST" and length(seg) is 1 and seg[0] is "have":
        sort = query_arg(path, "sort")
        if not known_sort(sort):
            return ok_svar("")
        edit saknas = []
        loop id in split(body, "\n"):
            t = trim(id)
            if safe_id(t) and not has_object(rd, sort, t):
                saknas = append(saknas, t)
        return ok_svar(join(saknas, "\n"))

    if length(seg) is 3 and seg[0] is "obj" and known_sort(seg[1]) and safe_id(seg[2]):
        if method is "GET":
            return ok_svar(if has_object(rd, seg[1], seg[2]) then get_object(rd, seg[1], seg[2]) else "")
        # POST och inte PUT: http-orben talar POST, och en verbsflora vore
        # ett andra satt att gora samma sak.
        if method is "POST":
            # Id:t kontrolleras mot innehallet. En klient kan inte lagga nagot
            # under ett id som inte ar dess hash - da vore lagret inte langre
            # innehallsadresserat, bara en mapp med namn.
            if sha256(body) is not seg[2]:
                return ok_svar("fel id")
            skrivet = put_object(rd, seg[1], body)
            return ok_svar("ok")

    if length(seg) is 1 and seg[0] is "ref":
        if method is "GET":
            return ok_svar(head_commit(root))
        if method is "POST":
            rader = split(body, "\n")
            gammal = if length(rader) > 0 then trim(rader[0]) else ""
            ny = if length(rader) > 1 then trim(rader[1]) else ""
            nu = head_commit(root)
            # Jamfor-och-satt: tva som pushar samtidigt far inte skriva over
            # varandra tyst. Den som ar sen far veta det och far hamta forst.
            if nu is not gammal:
                return ok_svar("stale {nu}")
            if not safe_id(ny):
                return ok_svar("fel id")
            skrivet = write_file(rd + "/" + head_ref(root), ny)
            return ok_svar("ok")

    # --- lasa ur lagret utan att kanna det ------------------------------
    # De har tre finns for att NAGON ANNAN ska kunna lasa ur repot. Med
    # bara /obj maste en lasare kanna hela objektmodellen: commit ->
    # manifest -> blob -> chunkar. Med de har racker en sokvag.
    #
    # En sokvag utifran kan inte klattra ur repot, for den slas upp i ett
    # MANIFEST. Finns den inte dar finns den inte, oavsett hur den stavas.

    if method is "GET" and length(seg) is 1 and seg[0] is "tree":
        c = at_commit(root, query_arg(path, "at"))
        if is_empty(c):
            return fel_svar(404, "ingen sadan commit")
        return ok_svar(rader_svar(commit_manifest(root, c)))

    if method is "GET" and length(seg) is 1 and seg[0] is "hist":
        return ok_svar(rader_svar(file_history(root, url_decode(query_arg(path, "path")))))

    if method is "GET" and length(seg) is 1 and seg[0] is "file":
        rel = url_decode(query_arg(path, "path"))
        c = at_commit(root, query_arg(path, "at"))
        if is_empty(c):
            return fel_svar(404, "ingen sadan commit")
        till_arg = query_arg(path, "to")
        # `to` utelamnat betyder "resten", och DA maste storleken tas fram
        # - vilket kostar en storleksfraga per chunk. Ar den given behovs
        # den inte, och en lasare mitt i en stor fil betalar bara for
        # chunkarna FORE sig.
        if is_empty(till_arg):
            n = file_size_at(root, c, rel)
            if n < 0:
                return fel_svar(404, "fanns inte i den commiten")
            return Svar{kod: 200, bitar: file_parts(root, c, rel, tal(query_arg(path, "from"), 0), n)}
        if not has_path(root, c, rel):
            return fel_svar(404, "fanns inte i den commiten")
        return Svar{kod: 200, bitar: file_parts(root, c, rel, tal(query_arg(path, "from"), 0), int_from_text(till_arg))}

    # Skrivvagen. Ett innehall in, en commit ut - se commit_file om varfor
    # ingen ko ar inblandad. `who` ar den som skriver, samma sjalvangivna
    # namn som lasen bar: hemligheten ar en dorrnyckel, inte en identitet.
    if method is "POST" and length(seg) is 1 and seg[0] is "file":
        rel = url_decode(query_arg(path, "path"))
        if is_empty(rel):
            return fel_svar(404, "ingen sokvag")
        who = url_decode(query_arg(path, "who"))
        msg = url_decode(query_arg(path, "msg"))
        if is_empty(req.fil):
            return fel_svar(409, "kroppen kom inte fram hel")
        sk = commit_file(root, rel, req.fil, if is_empty(who) then "okand" else who, if is_empty(msg) then rel else msg)
        if is_empty(sk.id):
            # 409: nagon annan haller filen, eller disken sa nej. Bada ar
            # "din skrivning hande inte", och kroppen sager vilket.
            return fel_svar(409, sk.fel)
        return ok_svar(sk.id + text_of([10]))

    if method is "GET" and length(seg) is 1 and seg[0] is "locks":
        return ok_svar(join(read_locks(root), "\n"))

    if method is "POST" and length(seg) is 1 and (seg[0] is "lock" or seg[0] is "unlock"):
        rader = split(body, "\n")
        if length(rader) < 2:
            return ok_svar("saknar vag och agare")
        vag = trim(rader[0])
        vem = trim(rader[1])
        return ok_svar(if seg[0] is "lock" then lock(root, vag, vem) else unlock(root, vag, vem))

    fel_svar(404, "")


# Servera tills processen stoppas. Ett svar per uppkoppling: pushar och
# pulls ar fa och stora, inte manga och sma, sa keep-alive vore komplexitet
# utan vinst.
public define serve(root: text, port: number) uses net, files, clock, console:
    if not is_repo(root):
        init(root)
    if is_empty(secret(root)):
        print_line("rune: ingen hemlighet satt for det har repot - `rune secret <varde>`")
        print_line("      utan den litar servern pa alla som nar porten.")
        return
    srv = listen(port)
    if srv < 0:
        print_line("rune: kunde inte lyssna pa {port}")
        return
    print_line("rune serve pa {port}, repo {root}  (Ctrl+C stoppar)")
    loop:
        conn = accept(srv)
        if conn >= 0:
            timeout = set_timeout(conn, 30000)
            req = read_request(conn, root)
            if not is_empty(req.head):
                if secret_ok(root, bearer(req.head)):
                    sv = handle(root, req)
                    answer_code(conn, sv.kod, reason_of(sv.kod), sv.bitar)
                else:
                    answer_code(conn, 401, "Unauthorized", ["fel eller saknad hemlighet"])
            stang = close(conn)

# --- klient -------------------------------------------------------------

use http

public define remote_url(root: text) -> text uses files:
    p = rune_dir(root) + "/remote"
    if file_exists(p) is 0 then "" else trim(read_file(p))

public define set_remote(root: text, url: text) uses files:
    write_file(rune_dir(root) + "/remote", trim(url))

# Hemligheten gar som HUVUD och aldrig i sokvagen: en URL hamnar i loggar
# och i kommandoradshistorik, ett huvud gor det inte. http-orben skickar
# huvuden genom en konfigfil, sa den syns inte heller for den som listar
# processer.
define auth(root: text) -> [text] uses files:
    s = secret(root)
    if is_empty(s) then [] else ["Authorization: Bearer {s}"]

define hamta(root: text, url: text) -> text uses net, files:
    r = fetch_with(url, auth(root))
    if success(r) then r.body else ""

define send_to(root: text, url: text, body: text) -> text uses net, files:
    r = post_with(url, "application/octet-stream", body, auth(root))
    if success(r) then r.body else ""

# Serverns ref, eller ett meddelande som borjar med "!". Varje operation
# borjar anda med den har fragan, sa det ar dar ett nej hor hemma - annars
# blir ett 401 tyst till "servern har inget an".
define ask_ref(root: text, url: text) -> text uses net, files:
    r = fetch_with("{url}/ref", auth(root))
    if r.status is 401:
        return "!fel eller saknad hemlighet - `rune secret <varde>`"
    if not success(r):
        return "!nadde inte servern: {trim(r.body)}"
    trim(r.body)

# De id servern saknar, av dem vi fragar om.
define missing(root: text, url: text, sort: text, ids: [text]) -> [text] uses net, files:
    if length(ids) is 0:
        return []
    edit out = []
    loop id in split(send_to(root, "{url}/have?sort={sort}", join(ids, "\n")), "\n"):
        if not is_empty(trim(id)):
            out = append(out, trim(id))
    out

# Antal skickade, eller -1 om NAGOT inte kom fram. Svaret MASTE lasas:
# forsta versionen raknade bara varv och rapporterade en lyckad push medan
# servern inte tog emot ett enda objekt - och satte sedan refen till en
# commit den inte hade.
define upload(root: text, url: text, rd: text, sort: text, ids: [text]) -> number uses net, files:
    edit n = 0
    loop id in missing(root, url, sort, ids):
        if send_to(root, "{url}/obj/{sort}/{id}", get_object(rd, sort, id)) is not "ok":
            return 0 - 1
        n = n + 1
    n

# Skicka allt HEAD hanger pa som servern saknar, och flytta sedan dess ref.
#
# Ordningen ar inte kosmetisk: chunkar fore blobbar fore manifest fore
# commits, och commits aldst forst. Servern far darfor aldrig ligga med ett
# objekt som pekar pa nagot den inte har, inte ens mitt i en avbruten push.
public define skicka(root: text) -> text uses net, files, console:
    url = remote_url(root)
    if is_empty(url):
        return "ingen remote satt - `rune remote <url>`"
    rd = rune_dir(root)
    mitt = head_commit(root)
    if is_empty(mitt):
        return "inget att pusha"
    kedja = log(root)
    # Ligger serverns commit i MIN kedja? Gor den inte det har nagon annan
    # pushat nagot jag inte har, och min push skulle radera deras arbete ur
    # refen. Att lasa serverns ref och skicka tillbaka den som "gammal" ar
    # inget skydd alls - den matchar alltid. Fragan maste stallas mot mig.
    deras = ask_ref(root, url)
    if starts_with(deras, "!"):
        return text_of(bytes_part(bytes_of(deras), 1, byte_count(deras)))
    if not is_empty(deras) and not has_text(kedja, deras):
        return "servern har commits du saknar - `rune pull` forst"
    saknade = missing(root, url, "commits", kedja)
    # aldst forst
    edit i = length(saknade) - 1
    edit skickade = 0
    loop:
        if i < 0:
            break
        c = saknade[i]
        man = commit_field(get_object(rd, "commits", c), "manifest")
        rader = commit_manifest(root, c)
        edit blobbar = []
        loop rad in rader:
            b = entry_blob(rad)
            blobbar = append(blobbar, b)
            edit chunkar = []
            loop cid in split(get_object(rd, "blobs", b), "\n"):
                if not is_empty(cid):
                    chunkar = append(chunkar, cid)
            n1 = upload(root, url, rd, "chunks", chunkar)
            if n1 < 0:
                return "avbrot: servern tog inte emot en chunk, refen ar orord"
            skickade = skickade + n1
        n2 = upload(root, url, rd, "blobs", blobbar)
        n3 = upload(root, url, rd, "manifests", [man])
        n4 = upload(root, url, rd, "commits", [c])
        if n2 < 0 or n3 < 0 or n4 < 0:
            return "avbrot: servern tog inte emot ett objekt, refen ar orord"
        skickade = skickade + n2 + n3 + n4
        i = i - 1
    # `deras` och inte en ny lasning: jamfor-och-satt ska vakta mot att
    # refen flyttade sedan jag kollade, och en fars lasning vaktar ingenting.
    svar = send_to(root, "{url}/ref", deras + text_of([10]) + mitt)
    if svar is "ok" then "pushade {skickade} objekt" else "refen flyttade under pushen: {svar}"

# Hamta serverns HEAD och allt den hanger pa. Ror INTE arbetstradet -
# `rune checkout <commit>` ar ett eget, medvetet steg.
public define pull(root: text) -> text uses net, files, console, env:
    url = remote_url(root)
    if is_empty(url):
        return "ingen remote satt - `rune remote <url>`"
    rd = rune_dir(root)
    deras = ask_ref(root, url)
    if starts_with(deras, "!"):
        return text_of(bytes_part(bytes_of(deras), 1, byte_count(deras)))
    if is_empty(deras):
        return "servern har inget an"
    # Ett smutsigt trad forst av allt: pull skriver over arbetstradet nar
    # den ar klar, och da far det inte finnas nagot dar som bara du har.
    # Kontrollen ligger FORE hamtningen, sa ett nej inte lamnar halva
    # servern nedladdad.
    if length(status(root)) > 0:
        return "du har andringar som inte ar committade - `rune status` visar dem"
    mitt = head_commit(root)
    if has_object(rd, "commits", deras):
        # Vi har den redan: antingen ar vi i fas, eller sa ligger vi fore.
        # Att satta refen anda hade flyttat oss BAKAT och tappat commits.
        return if deras is mitt then "redan i fas" else "du ligger fore servern - `rune push`"
    # Kedjan bakat tills nagot vi redan har, sedan hem i den ordningen.
    edit att_hamta = []
    edit id = deras
    loop:
        if is_empty(id) or id is "-" or has_object(rd, "commits", id):
            break
        kropp = hamta(root, "{url}/obj/commits/{id}")
        if is_empty(kropp):
            return "servern saknar commit {id}"
        att_hamta = append(att_hamta, id + text_of([9]) + kropp)
        id = commit_field(kropp, "parent")
    # `id` ar den forsta commit vi kande igen. Ar den inte vart HEAD har vi
    # egna commits vid sidan av deras, och en pull som satter refen hade
    # kastat dem. Rune snabbspolar bara - binarer gar anda inte att sla
    # ihop, och det ar darfor lasen finns.
    if not is_empty(mitt) and id is not mitt:
        return "du och servern har gatt isar - dina commits ligger kvar, men rune snabbspolar bara"
    edit hamtade = 0
    edit i = length(att_hamta) - 1
    loop:
        if i < 0:
            break
        f = split(att_hamta[i], text_of([9]))
        man = commit_field(f[1], "manifest")
        hamtade = hamtade + fetch_object(root, url, rd, "manifests", man)
        loop rad in split(get_object(rd, "manifests", man), "\n"):
            if not is_empty(rad):
                b = split(rad, text_of([9]))[1]
                hamtade = hamtade + fetch_object(root, url, rd, "blobs", b)
                loop cid in split(get_object(rd, "blobs", b), "\n"):
                    if not is_empty(cid):
                        hamtade = hamtade + fetch_object(root, url, rd, "chunks", cid)
        skrev = put_object(rd, "commits", f[1])
        i = i - 1
    skrivet = write_file(rd + "/" + head_ref(root), deras)
    # Och arbetstradet dit. Tradet var rent nar vi borjade, sa allt som
    # skiljer nu ar det vi just hamtade hem.
    n = write_tree(root, deras)
    # Tradet ar nyss omskrivet, sa skydden ska sattas om.
    apply_locks(root, author_name(), [])
    if n < 0:
        return "hamtade {hamtade} objekt, men lagret saknar chunkar - arbetstradet ororda"
    "hamtade {hamtade} objekt, skrev {n} fil(er), HEAD ar {deras}"

# Hamta ett objekt vi saknar. Innehallet kontrolleras mot sitt id: det ar
# put_object som hashar, sa ett id som inte stammer skriver fel fil och
# upptacks har istallet for tre commits senare.
define fetch_object(root: text, url: text, rd: text, sort: text, id: text) -> number uses net, files:
    if has_object(rd, sort, id):
        return 0
    kropp = hamta(root, "{url}/obj/{sort}/{id}")
    if is_empty(kropp) and id is not sha256(""):
        return 0
    fick = put_object(rd, sort, kropp)
    if fick is not id:
        return 0
    1

# --- las over remoten ---------------------------------------------------
# Med en remote satt ar SERVERN sanningen om lasen. Det ar hela poangen:
# ett las som bara finns lokalt kan aldrig saga att nagon ANNAN haller
# filen, och da ar det ingen sparr, bara en anteckning.

# Skydden pa disk sitter i bada grenarna, for det ar HAR laset andras.
# Utan remote skriver vi tabellen sjalva; med en ar servern sanningen och
# sync_locks hamtar hem den nya tabellen och satter skydden efter den.
public define lock_here(root: text, path: text, owner: text) -> text uses net, files, clock, env:
    url = remote_url(root)
    if is_empty(url):
        svar = lock(root, path, owner)
        apply_locks(root, owner, [])
        return svar
    svar = trim(send_to(root, "{url}/lock", path + text_of([10]) + owner))
    n = sync_locks(root)
    svar

public define unlock_here(root: text, path: text, owner: text) -> text uses net, files, env:
    forra = read_locks(root)
    url = remote_url(root)
    if is_empty(url):
        svar = unlock(root, path, owner)
        apply_locks(root, owner, forra)
        return svar
    svar = trim(send_to(root, "{url}/unlock", path + text_of([10]) + owner))
    n = sync_locks(root)
    svar

public define locks_here(root: text) -> [text] uses net, files:
    url = remote_url(root)
    if is_empty(url):
        return read_locks(root)
    edit out = []
    loop l in split(hamta(root, "{url}/locks"), "\n"):
        if not is_empty(trim(l)):
            out = append(out, trim(l))
    out

# Hamta serverns lastabell till den lokala filen. `add` har sin sparr mot
# den lokala tabellen (lagret kan inte natet, och ska inte kunna det), sa
# den maste fyllas innan koandet. Cachen kan vara gammal - men servern ar
# anda den som avgor nar nagon FORSOKER ta ett las, sa det varsta som kan
# handa ar att man far reda pa det ett steg senare.
public define sync_locks(root: text) -> number uses net, files, env:
    if is_empty(remote_url(root)):
        return 0
    forra = read_locks(root)
    rader = locks_here(root)
    skrivet = write_file(rune_dir(root) + "/locks", if length(rader) is 0 then "" else join(rader, "\n") + text_of([10]))
    # Tabellen ar ny, sa skrivskyddet pa disk ska folja med den.
    apply_locks(root, author_name(), forra)
    length(rader)

# Ett steg istallet for fyra. Utan den ar "hamta hem repot" init, remote,
# pull och checkout i ratt ordning, och fel ordning ger ett tomt trad utan
# att saga varfor.
#
# Vagrar mot en mapp som redan har ett repo: att blanda tva historier i
# samma .rune ar inget nagon menar.
public define clone(root: text, url: text, hemlig: text) -> text uses net, files, console, env:
    if is_repo(root):
        return "har finns redan ett rune-repo"
    if length(walk(root)) > 0:
        return "mappen ar inte tom - en clone skriver ett helt trad"
    init(root)
    set_remote(root, url)
    set_secret(root, hemlig)
    # Resten ar pull: den hamtar, flyttar HEAD och skriver arbetstradet.
    # Forut stod en egen checkout har, och det var tva satt att gora samma
    # sak - de kunde glida isar och det ena var alltid det som testades.
    pull(root)
