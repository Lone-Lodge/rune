# rune - CLI.
#
#   rune init                    starta ett repo har
#   rune add <sokvag> | .        koa en fil, eller hela tradet
#   rune status                  vad som ar koat, andrat, nytt, borttaget
#   rune commit <meddelande>     koen blir en ogonblicksbild
#   rune log                     commit-kedjan fran HEAD och bakat
#   rune checkout <commit>       skriv ut en ogonblicksbild till arbetstradet
#   rune history <sokvag>        filens versioner, nyast forst
#   rune show <commit> <sokvag> <utfil>   filens innehall vid en commit
#   rune lock <sokvag>           ta filen, ingen annan far koa den
#   rune unlock <sokvag>         slapp den
#   rune locks                   vem haller vad
#   rune clone <url>             init + remote + pull + checkout i ett
#   rune remote [url]            visa eller satt remoten
#   rune push                    skicka det servern saknar
#   rune pull                    hamta det du saknar (ror inte arbetstradet)
#   rune serve [port]            servera repot for push och pull
#   rune stat <fil>              visa chunkningen utan att lagra nagot

use rune
use rune_remote
use os
use text
use time

define root() -> text = "."

define need_repo() -> truth uses files, console:
    if is_repo(root()):
        return true
    print_line("inget rune-repo har. `rune init` forst.")
    false

define cmd_init() uses files, console:
    if is_repo(root()):
        print_line("finns redan")
    else:
        init(root())
        print_line("tomt rune-repo i .rune/")

define cmd_add(what: text) uses files, console, env, net:
    me = author_name()
    fardsk = sync_locks(root())
    k = if what is "." then add_tree(root(), me) else add(root(), [what], me)
    loop rel in k.last:
        print_line("  last av {lock_owner(root(), rel)}: {rel}")
    print_line("koade {k.antal} fil(er)")
    if length(k.last) > 0:
        print_line("{length(k.last)} hoppades over - las slapps med `rune unlock`")

define cmd_lock(path: text) uses files, console, clock, env, net:
    held = lock_here(root(), path, author_name())
    if is_empty(held):
        print_line("last: {path}")
    else:
        print_line("redan last av {held}: {path}")

define cmd_unlock(path: text) uses files, console, env, net:
    held = unlock_here(root(), path, author_name())
    if is_empty(held):
        print_line("slappt: {path}")
    else:
        print_line("hall av {held}, inte din att slappa: {path}")

define cmd_locks() uses files, console, net:
    edit n = 0
    loop l in locks_here(root()):
        print_line("  {lock_holder(l)}  {entry_path(l)}")
        n = n + 1
    if n is 0:
        print_line("inga las")

define cmd_status() uses files, console:
    loop row in status(root()):
        f = split(row, text_of([9]))
        print_line("  {pad_right(f[0], 10, " ")}{f[1]}")

define cmd_commit(msg: text) uses files, console, clock, env:
    id = commit(root(), msg, author_name())
    if is_empty(id):
        print_line("inget koat")
    else:
        print_line("{id} {msg}")

define cmd_log() uses files, console:
    loop id in log(root()):
        body = get_object(rune_dir(root()), "commits", id)
        short = text_of(bytes_part(bytes_of(id), 0, 12))
        when = utc_time(int_from_text(commit_field(body, "time")), "%Y-%m-%d %H:%M")
        print_line("{short}  {when}  {commit_field(body, "author")}  {commit_message(body)}")

define cmd_checkout(vad: text) uses files, console:
    id = resolve(root(), vad)
    if is_empty(id):
        print_line("ingen entydig commit for {vad} - `rune log` visar vilka som finns")
        return
    n = checkout(root(), id)
    if n < 0:
        print_line("lagret saknar chunkar for {id} - inget skrivet. `rune pull` forst?")
    else:
        print_line("skrev {n} fil(er)")

define cmd_history(rel: text) uses files, console:
    edit n = 0
    loop row in file_history(root(), rel):
        f = split(row, text_of([9]))
        print_line("  {text_of(bytes_part(bytes_of(f[0]), 0, 12))}  {utc_time(int_from_text(f[1]), "%Y-%m-%d %H:%M")}")
        n = n + 1
    if n is 0:
        print_line("ingen historik for {rel}")

# Skriver till FIL, aldrig till stdout: binart innehall genom en konsol
# blir CRLF-oversatt pa Windows och kommer fram trasigt.
define cmd_show(id: text, rel: text, out: text) uses files, console:
    body = file_at(root(), id, rel)
    if is_empty(body):
        print_line("fanns inte i {id}: {rel}")
    else:
        write_file(out, body)
        print_line("skrev {out}")

# Hemligheten skrivs, men skrivs aldrig UT. Att kunna se om en ar satt ar
# det man behover; att kunna lasa den ur en terminalhistorik ar det man inte
# vill.
define cmd_secret(varde: text) uses files, console:
    if is_empty(varde):
        print_line(if is_empty(secret(root())) then "ingen hemlighet satt" else "en hemlighet ar satt")
    else:
        set_secret(root(), varde)
        print_line("hemligheten satt")

define cmd_stat(path: text) uses files, console:
    b = bytes_of(read_file(path))
    cuts = chunk_offsets(b)
    n = bytes_count(b)
    print_line("{path}: {n} bytes, {length(cuts)} chunkar")

define main() -> number uses files, console, clock, env, net:
    args = arguments()
    if length(args) < 2:
        print_line("rune init | add | status | commit | log | checkout | history | show | lock | unlock | locks | clone | remote | push | pull | serve | stat")
        return 1
    cmd = args[1]
    if cmd is "init":
        cmd_init()
    else if cmd is "add":
        if need_repo():
            cmd_add(if length(args) > 2 then args[2] else ".")
    else if cmd is "status":
        if need_repo():
            cmd_status()
    else if cmd is "commit":
        if need_repo():
            cmd_commit(if length(args) > 2 then args[2] else "utan meddelande")
    else if cmd is "log":
        if need_repo():
            cmd_log()
    else if cmd is "checkout":
        if need_repo():
            cmd_checkout(args[2])
    else if cmd is "lock":
        if need_repo():
            cmd_lock(args[2])
    else if cmd is "unlock":
        if need_repo():
            cmd_unlock(args[2])
    else if cmd is "locks":
        if need_repo():
            cmd_locks()
    else if cmd is "history":
        if need_repo():
            cmd_history(args[2])
    else if cmd is "show":
        if need_repo():
            cmd_show(args[2], args[3], args[4])
    else if cmd is "clone":
        if length(args) < 4:
            print_line("rune clone <url> <hemlighet>")
        else:
            print_line(clone(root(), args[2], args[3]))
    else if cmd is "secret":
        if need_repo():
            cmd_secret(if length(args) > 2 then args[2] else "")
    else if cmd is "remote":
        if need_repo():
            if length(args) > 2:
                set_remote(root(), args[2])
            print_line(if is_empty(remote_url(root())) then "ingen remote satt" else remote_url(root()))
    else if cmd is "push":
        if need_repo():
            print_line(skicka(root()))
    else if cmd is "pull":
        if need_repo():
            print_line(pull(root()))
    else if cmd is "serve":
        serve(root(), if length(args) > 2 then int_from_text(args[2]) else 7420)
    else if cmd is "stat":
        cmd_stat(args[2])
    else:
        print_line("okant kommando: {cmd}")
        return 1
    0
